<?xml version="1.0" encoding="UTF-8"?>
<project
     xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
    http://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.covaid</groupId>
    <artifactId>org.covaid.parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

  	<licenses>
    	<license>
      		<name>Apache License, Version 2.0</name>
      		<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      		<distribution>repo</distribution>
    	</license>
  	</licenses>

    <properties>
        <generics>P:/GitHub</generics>
 		<maven.compiler.release>22</maven.compiler.release>		
    	<tycho.version>5.0.4</tycho.version>
		<bundle-name>org.covaid</bundle-name>
        <major.version>1.0.0</major.version>
        <minor.version>SNAPSHOT</minor.version>
        <revision>${major.version}-${minor.version}</revision>
        <build.name>RAP3X</build.name>

        <project.root>${generics}/${bundle.name}</project.root>
        <workspace.root>P:/Windows/Condast/Workspace/${bundle.name}</workspace.root>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>  

        <condast.commons>file:${generics}/org.condast.commons/Workspace</condast.commons>
        <condast.js>file:${generics}/org.condast.js/Workspace/</condast.js>
        <update.site>${project.root}/Workspace/${bundle.name}.update/target/repository/plugins</update.site>
		<release-dir>P:/Releases</release-dir>
    </properties>

    <profiles>
        <profile>
            <id>local-deploy</id>
            <distributionManagement>
                <repository>
                  <id>local-releases</id>
                  <url>http://localhost:8081/repository/maven-releases/</url>
                </repository>
                <snapshotRepository>
                  <id>local-snapshots</id>
                  <url>http://localhost:8081/repository/maven-snapshots/</url>
                </snapshotRepository>
                <site>
                   <id>nexus-eclipse-updates</id>
                   <url>${p2.update.site}/${bundle.name}/</url>
                </site>
            </distributionManagement>
        </profile>
        <profile>
            <id>cloud-deploy</id>
            <distributionManagement>
                <repository>
                    <id>cloud-releases</id>
                    <url>http://localhost:18081/repository/maven-releases/</url>
                </repository>
                <snapshotRepository>
                    <id>cloud-snapshots</id>
                    <url>http://localhost:18081/repository/maven-snapshots/</url>
                </snapshotRepository>
                <site>
                   <id>nexus-eclipse-updates</id>
                   <url>${p2.update.site}/${bundle.name}/</url>
                </site>

            </distributionManagement>
        </profile>
    </profiles>

  <modules>
    <module>../org.covaid.target</module>
    <module>../org.covaid.core</module>
    <module>../org.covaid.ui</module>
    <module>../org.covaid.commons.support</module>
    <module>../org.covaid.orientdb</module>
    <module>../org.covaid.mobile</module>
    <module>../org.covaid.rest</module>
    <module>../org.covaid.dashboard</module>
    <module>../org.covaid.feature</module>
    <module>../org.covaid.update</module>
  </modules>
  
    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>

            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <executionEnvironment>JavaSE-22</executionEnvironment>
 					<pomDependencies>consider</pomDependencies>
					<target>
						<artifact>
							<groupId>org.condast.commons.jpa</groupId>
							<artifactId>org.condast.commons.jpa.target</artifactId>
							<version>${project.version}</version>
						</artifact>
						<artifact>
			                <groupId>org.covaid</groupId>
			                <artifactId>org.covaid.target</artifactId>
			                <version>1.0.0-SNAPSHOT</version>
			            </artifact>
					</target>
                      <environments>
                        <environment>
                            <os>linux</os>
                            <ws>gtk</ws>
                            <arch>x86</arch>
                        </environment>
                        <environment>
                            <os>linux</os>
                            <ws>gtk</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>x86</arch>
                        </environment>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>x86_64</arch>
                        </environment>
                    </environments>
                </configuration>
            </plugin>
            <plugin>
               <groupId>org.eclipse.tycho</groupId>
               <artifactId>tycho-p2-repository-plugin</artifactId>
               <version>${tycho.version}</version>
               <configuration>
                 <skipArchive>true</skipArchive>
                 <includeAllDependencies>false</includeAllDependencies>
               </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>copy-resource-one</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <overwrite>true</overwrite>
                            <outputDirectory>${release.dir}/${maven.build.timestamp}</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>${update.site}</directory>
                                    </resource>
                                </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.12.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>false</autoPublish>
                    <waitUntil>validated</waitUntil>
                </configuration>
            </plugin>            
        </plugins>
    </build>
</project> 