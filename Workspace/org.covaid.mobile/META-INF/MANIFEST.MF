Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: CovAID Mobile Emulator
Bundle-SymbolicName: org.covaid.mobile;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: org.covaid.mobile.Activator
Bundle-Vendor: Condast
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
Automatic-Module-Name: org.covaid.rest
Import-Package: com.google.gson;version="2.7.0",
 com.orientechnologies.orient.core.entity;version="2.2.37",
 com.orientechnologies.orient.object.db;version="2.2.37",
 javax.persistence;version="2.2.0",
 javax.persistence.metamodel;version="[2.2.0,3.0.0)",
 javax.servlet;version="3.0.0",
 javax.servlet.http;version="3.0.0",
 javax.ws.rs;version="2.0.1",
 javax.ws.rs.core;version="2.0.1",
 org.condast.commons,
 org.condast.commons.data.plane,
 org.condast.commons.i18n,
 org.condast.commons.jpa.messaging,
 org.condast.commons.jpa.persistence,
 org.condast.commons.jpa.rest,
 org.condast.commons.parser,
 org.condast.commons.preferences.config,
 org.condast.commons.project,
 org.condast.commons.strings,
 org.condast.js.push.core,
 org.condast.js.push.core.advice,
 org.covaid.core.data,
 org.covaid.core.def,
 org.covaid.core.doctor,
 org.covaid.core.field,
 org.covaid.core.model,
 org.covaid.core.model.date,
 org.covaid.orientdb.def,
 org.covaid.orientdb.object,
 org.glassfish.jersey.server;version="2.25.1",
 org.glassfish.jersey.servlet;version="2.25.1",
 org.osgi.framework;version="1.5.0",
 org.osgi.service.component.annotations;version="1.1.0",
 org.osgi.service.http.whiteboard.propertytypes;version="[1.1.0,2.0.0)"
Require-Bundle: com.orientechnologies.orientdb-core;bundle-version="2.2.37",
 wrapped.com.tinkerpop.blueprints.blueprints-core;bundle-version="2.6.0"
Bundle-ActivationPolicy: lazy
Service-Component: OSGI-INF/org.covaid.mobile.doctor.data.xml,
 OSGI-INF/org.covaid.mobile.persistence.EntityManagerService.xml,
 OSGI-INF/org.covaid.mobile.rest.RestServlet.xml,
 OSGI-INF/org.covaid.mobile.service.field.xml
